MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=academic_assistant
SCHOLARSYNC_DEFAULT_USER_ID=local_user
SCHOLARSYNC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCHOLARSYNC_EMBEDDING_DIMENSION=384
SCHOLARSYNC_CHUNK_COLLECTION=academic_chunks
SCHOLARSYNC_CHUNK_SIZE_WORDS=420
SCHOLARSYNC_CHUNK_OVERLAP_WORDS=80

# local = runs cosine search in Python over stored MongoDB embeddings.
# atlas = uses MongoDB Atlas $vectorSearch. Requires an Atlas Search vector index.
SCHOLARSYNC_VECTOR_SEARCH_MODE=local
SCHOLARSYNC_ATLAS_VECTOR_INDEX=academic_chunks_vector_index

# Search mode: "vector" (default), "hybrid" (BM25 + vector with RRF), or "keyword"
SCHOLARSYNC_SEARCH_MODE=vector
